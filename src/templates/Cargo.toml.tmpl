[package]
edition = "2024"
name = "{{project_name}}"
version = "0.1.0"

[[bin]]
name = "{{project_name}}"
test = false
bench = false

[dependencies]
embassy-executor = { version = "0.10.0", features = ["defmt"] }
embassy-time = { version = "0.5.1", features = ["defmt", "defmt-timestamp-uptime"] }
embassy-rp = { version = "0.10.0", features = ["defmt", "unstable-pac", "time-driver", "critical-section-impl", "{{chip_feature}}", "executor-thread", "executor-interrupt"] }
defmt = "1.0.1"
defmt-rtt = "1.0.0"


cortex-m = { version = "0.7.6", features = ["inline-asm"] }
cortex-m-rt = "0.7.0"
panic-probe = { version = "1.0.0", features = ["print-defmt"] }


[profile.release]
# Enable generation of debug symbols even on release builds
debug = true
