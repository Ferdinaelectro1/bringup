[package]
edition = "{{edition}}"
name = "{{project_name}}"
version = "{{version}}"

[[bin]]
name = "{{project_name}}"
test = false
bench = false

[dependencies]
embassy-executor = { version = "{{ dependencies["embassy-executor-version"] }}", features = ["defmt"] }
embassy-time = { version = "{{ dependencies["embassy-time-version"] }}", features = ["defmt", "defmt-timestamp-uptime"] }
embassy-rp = { version = "{{ dependencies["embassy-rp-version"] }}", features = ["defmt", "unstable-pac", "time-driver", "critical-section-impl", "{{chip_feature}}", "executor-thread", "executor-interrupt"] }
defmt = "{{ dependencies["defmt-version"] }}"
defmt-rtt = "{{ dependencies["defmt-rtt-version"] }}"

cortex-m = { version = "{{ dependencies["cortex-m-version"] }}", features = ["inline-asm"] }
cortex-m-rt = "{{ dependencies["cortex-m-rt-version"] }}"
panic-probe = { version = "{{ dependencies["panic-probe-version"] }}", features = ["print-defmt"] }

[profile.release]
# Enable generation of debug symbols even on release builds
debug = true
